# Copia este archivo como .env y rellena los valores reales.
# .env esta en .gitignore y NUNCA debe subirse al repositorio.

NEO4J_URI=neo4j+s://XXXXXXXX.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=tu_password_de_aura
# En Aura la base suele llamarse como el id de la instancia (ej. 8c291be1),
# no 'neo4j'. Dejalo vacio para usar la base por defecto del usuario.
NEO4J_DATABASE=

# URL de la API de Django que consume el cliente de Streamlit
API_BASE_URL=http://127.0.0.1:8000/api
